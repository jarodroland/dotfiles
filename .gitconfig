# This is Git's per-user configuration file.
[user]
	name = Jarod Roland
	email = jarod.roland@gmail.com
[core]
	whitespace = cr-at-eol
	autocrlf = false
    excludesfile = ~/.gitignore
    abbrev = 12
[alias]
    l  = log --graph --oneline --decorate
    ld = log --graph --pretty=format:'%C(yellow)%h%C(bold white red)%d%Creset %s %C(bold green)%cr %Creset%C(white)%an' --abbrev-commit --date=relative
    ll = log --stat --decorate --source -p
    branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
[color]
	ui = true
[status]
	submoduleSummary = true
[diff]
    submodule = log
[commit]
    verbose = true
[push]
    default = current
[diff]
    algorithm = histogram       # myers (default), minimal, patience, histogram
    colorMoved = dimmed_zebra   # zebra (default), no, plain, dimmed_zebra 
