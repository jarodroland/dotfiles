#!/bin/bash

# From: https://github.com/gretzky/dotfiles/blob/master/macos/.macos
# which is based off of https://github.com/mathiasbynens/dotfiles/blob/main/.macos

# Avoid creating .DS_Store files on network or USB volumes
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# export JAVA_HOME so JRE works at the command line
export JAVA_HOME=/Library/Internet\ Plug-Ins/JavaAppletPlugin.plugin/Contents/Home

# disable writing .DS_Store to network mounts or USB drives
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# show full path in Finder title
defaults write com.apple.finder _FXShowPosixPathInTitle -bool true

# show path bar in bottom of Finder window
defaults write com.apple.finder ShowPathbar -bool true

# Use list view in all Finder windows by default
# Four-letter codes for the other view modes: `icnv`, `clmv`, `glyv`
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

# Show the /Volumes folder
sudo chflags nohidden /Volumes

# make Citrix Viewer launch URLs in local web browser
defaults write com.citrix.receiver.icaviewer.mac LocalLaunchDisabled -bool false

